{
  "name": "dsh-recent-sessions",
  "version": "0.1.0",
  "description": "Cross-workspace recent sessions at the bottom of the DSH Web workspace tree",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/hotheat/dsh-recent-sessions.git" },
  "homepage": "https://github.com/hotheat/dsh-recent-sessions",
  "bugs": { "url": "https://github.com/hotheat/dsh-recent-sessions/issues" },
  "author": "Jiaoguo",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "sessions", "sidebar"],
  "scripts": {
    "test": "node test/client-load.mjs && node --test test/rows.mjs test/portal.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "engines": { "dsh": ">=0.2.1-rc.2" },
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
